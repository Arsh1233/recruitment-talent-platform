<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Completion_cannot_precede_request</fullName>
    <active>true</active>
    <errorConditionFormula>AND(    NOT(ISBLANK(Requested_At__c)),    NOT(ISBLANK(Completed_At__c)),    Completed_At__c &lt; Requested_At__c )</errorConditionFormula>
    <errorMessage>Completion cannot precede request</errorMessage>
</ValidationRule>
