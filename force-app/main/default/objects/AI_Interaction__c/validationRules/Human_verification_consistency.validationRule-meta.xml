<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Human_verification_consistency</fullName>
    <active>true</active>
    <errorConditionFormula>AND(   Is_Human_Verified__c,    NOT(Is_Human_Verification_Required__c))</errorConditionFormula>
    <errorMessage>Human verification cannot be completed when verification was not required</errorMessage>
</ValidationRule>
