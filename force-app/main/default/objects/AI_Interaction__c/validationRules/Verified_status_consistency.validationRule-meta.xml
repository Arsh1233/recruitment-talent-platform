<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Verified_status_consistency</fullName>
    <active>true</active>
    <errorConditionFormula>AND(    ISPICKVAL(Status__c, &quot;Verified&quot;),    NOT(Is_Human_Verified__c) )</errorConditionFormula>
    <errorMessage>Verified status consistency</errorMessage>
</ValidationRule>
