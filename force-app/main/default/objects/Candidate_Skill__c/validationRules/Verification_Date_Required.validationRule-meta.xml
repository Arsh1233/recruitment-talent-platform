<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Verification_Date_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
 OR(
  Is_Candidate_Verified__c,
  Is_Recruiter_Verified__c
 ),
 ISBLANK(Verification_Date__c)
)</errorConditionFormula>
    <errorMessage>Verification Date Required</errorMessage>
</ValidationRule>
