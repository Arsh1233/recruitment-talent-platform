<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Total_Experience_Cannot_Be_Negative</fullName>
    <active>true</active>
    <description>Prevents negative total-experience values.</description>
    <errorConditionFormula>Total_Experience__c &lt; 0</errorConditionFormula>
    <errorMessage>Total Experience cannot be negative.</errorMessage>
</ValidationRule>
