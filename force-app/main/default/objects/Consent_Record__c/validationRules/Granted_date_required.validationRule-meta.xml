<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Granted_date_required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    Is_Granted__c,
    ISBLANK(Granted_At__c)
)</errorConditionFormula>
    <errorMessage>Granted date required</errorMessage>
</ValidationRule>
