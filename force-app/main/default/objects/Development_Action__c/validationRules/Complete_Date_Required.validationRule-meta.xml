<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Complete_Date_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL(Status__c, &quot;Completed&quot;),
ISBLANK(Completion_Date__c)
)</errorConditionFormula>
    <errorDisplayField>Completion_Date__c</errorDisplayField>
    <errorMessage>Completion Date is required when the action is marked Completed</errorMessage>
</ValidationRule>
