<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Completed_Action_Requires_Outcome</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL(Status__c, &quot;Completed&quot;),
ISBLANK(Outcome__c)
)</errorConditionFormula>
    <errorMessage>Outcome is required when the action is marked Completed</errorMessage>
</ValidationRule>
