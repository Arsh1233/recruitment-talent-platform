<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>No_completion_Date_For_Incomplete_Action</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
NOT(ISPICKVAL(Status__c, &quot;Completed&quot;)),
NOT(ISBLANK(Completion_Date__c))
)</errorConditionFormula>
    <errorMessage>Completion Date must be blank unless the action is Completed</errorMessage>
</ValidationRule>
