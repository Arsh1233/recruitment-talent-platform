<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Completed_Date_After_Start</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  NOT(ISBLANK(Completed_Date__c)),
  NOT(ISBLANK(Start_Date__c)),
  Completed_Date__c &lt; Start_Date__c
)</errorConditionFormula>
    <errorDisplayField>Completed_Date__c</errorDisplayField>
    <errorMessage>Completed Date cannot be before Start Date</errorMessage>
</ValidationRule>
