<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Target_Date_After_Start</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  NOT(ISBLANK(Start_Date__c)),
  NOT(ISBLANK(Target_Date__c)),
  Target_Date__c &lt; Start_Date__c
)</errorConditionFormula>
    <errorDisplayField>Target_Date__c</errorDisplayField>
    <errorMessage>Target Date must be on or after Start Date</errorMessage>
</ValidationRule>
