<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Current_study_should_not_have_an_end_dat</fullName>
    <active>true</active>
    <errorConditionFormula>AND(    Is_Currently_Studying__c,    NOT(ISBLANK(End_Date__c)) )</errorConditionFormula>
    <errorMessage>Current study should not have an end date</errorMessage>
</ValidationRule>
