<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>HTTP_status_range</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(HTTP_Status__c)),
    OR(
        HTTP_Status__c &lt; 100,
        HTTP_Status__c &gt; 599
    )
)</errorConditionFormula>
    <errorMessage>HTTP status range</errorMessage>
</ValidationRule>
