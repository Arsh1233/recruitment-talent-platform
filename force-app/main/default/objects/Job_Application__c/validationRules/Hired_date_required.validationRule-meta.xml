<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Hired_date_required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
 ISPICKVAL(Status__c, &quot;Hired&quot;),
 ISBLANK(Hired_Date__c)
)</errorConditionFormula>
    <errorMessage>Hired date required</errorMessage>
</ValidationRule>
