<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Positive_Profile_Version</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
 NOT(ISBLANK(Candidate_Profile_Version__c)),
 Candidate_Profile_Version__c &lt;= 0
)</errorConditionFormula>
    <errorMessage>Positive Profile Version</errorMessage>
</ValidationRule>
