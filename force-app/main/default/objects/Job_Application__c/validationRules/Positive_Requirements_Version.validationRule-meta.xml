<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Positive_Requirements_Version</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
 NOT(ISBLANK(Job_Requirements_Version__c)),
 Job_Requirements_Version__c &lt;= 0
)</errorConditionFormula>
    <errorMessage>Positive Requirements Version</errorMessage>
</ValidationRule>
