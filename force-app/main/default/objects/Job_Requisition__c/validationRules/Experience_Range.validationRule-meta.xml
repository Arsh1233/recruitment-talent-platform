<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Experience_Range</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
 NOT(ISBLANK(Minimum_Experience__c)),
 NOT(ISBLANK(Maximum_Experience__c)),
 Maximum_Experience__c &lt; Minimum_Experience__c
)</errorConditionFormula>
    <errorMessage>Maximum Experience cannot be less than Minimum Experience.</errorMessage>
</ValidationRule>
