<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Salary_Range</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
 NOT(ISBLANK(Minimum_Salary__c)),
 NOT(ISBLANK(Maximum_Salary__c)),
 Maximum_Salary__c &lt; Minimum_Salary__c
)</errorConditionFormula>
    <errorMessage>Maximum Salary cannot be less than Minimum Salary.</errorMessage>
</ValidationRule>
