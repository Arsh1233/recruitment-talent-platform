<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Superseded_consistency</fullName>
    <active>true</active>
    <errorConditionFormula>AND(    Is_Superseded__c,    NOT(ISPICKVAL(Status__c, &quot;Superseded&quot;)) )</errorConditionFormula>
    <errorMessage>A superseded Match Result must have the Superseded status.</errorMessage>
</ValidationRule>
