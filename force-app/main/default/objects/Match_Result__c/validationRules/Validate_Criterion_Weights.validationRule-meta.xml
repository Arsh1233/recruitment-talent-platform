<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validate_Criterion_Weights</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(Status__c, &quot;Completed&quot;),
  ABS(Total_Criterion_Weight__c - 100) &gt; 0.01
)</errorConditionFormula>
    <errorMessage>Criterion weights must total exactly 100 before completing the Match Result</errorMessage>
</ValidationRule>
