<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Accepted_Details_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(Status__c, &quot;Accepted&quot;),
  OR(
    ISBLANK(Joining_Date__c),
    ISBLANK(Response_Date__c)
  )
)</errorConditionFormula>
    <errorDisplayField>Joining_Date__c</errorDisplayField>
    <errorMessage>Joining Date and Response Date are required when an offer is accepted</errorMessage>
</ValidationRule>
