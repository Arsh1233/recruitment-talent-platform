<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Decline_Reason_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(Status__c, &quot;Declined&quot;),
  ISBLANK(Decline_Reason__c)
)</errorConditionFormula>
    <errorDisplayField>Decline_Reason__c</errorDisplayField>
    <errorMessage>Decline Reason is required when an offer is declined</errorMessage>
</ValidationRule>
