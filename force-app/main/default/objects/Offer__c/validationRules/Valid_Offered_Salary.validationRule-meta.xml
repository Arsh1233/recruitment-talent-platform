<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Valid_Offered_Salary</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Offered_Salary__c)),
    Offered_Salary__c &lt;= 0
)</errorConditionFormula>
    <errorDisplayField>Offered_Salary__c</errorDisplayField>
    <errorMessage>Offered Salary must be greater than zero</errorMessage>
</ValidationRule>
