<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Valid_Version</fullName>
    <active>true</active>
    <errorConditionFormula>Version_Number__c &lt;= 0</errorConditionFormula>
    <errorDisplayField>Version_Number__c</errorDisplayField>
    <errorMessage>Version Number must be greater than zero</errorMessage>
</ValidationRule>
