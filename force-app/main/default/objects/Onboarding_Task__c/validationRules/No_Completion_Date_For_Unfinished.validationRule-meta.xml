<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>No_Completion_Date_For_Unfinished</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISPICKVAL(Status__c, &quot;Completed&quot;)),
    NOT(ISBLANK(Completed_Date__c))
)</errorConditionFormula>
    <errorDisplayField>Completed_Date__c</errorDisplayField>
    <errorMessage>Completed Date can only be set when the task is Completed</errorMessage>
</ValidationRule>
