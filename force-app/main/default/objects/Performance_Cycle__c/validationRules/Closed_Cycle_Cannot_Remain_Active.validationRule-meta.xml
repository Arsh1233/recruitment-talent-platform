<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Closed_Cycle_Cannot_Remain_Active</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  Is_Active__c,
  OR(
    ISPICKVAL(Status__c, &quot;Closed&quot;),
    ISPICKVAL(Status__c, &quot;Cancelled&quot;)
  )
)</errorConditionFormula>
    <errorDisplayField>Is_Active__c</errorDisplayField>
    <errorMessage>Closed or Cancelled cycle cannot remain active</errorMessage>
</ValidationRule>
