<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Completed_Goal_Progress</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(Status__c, &quot;Completed&quot;),
  Progress_Percentage__c &lt;&gt; 100
)</errorConditionFormula>
    <errorDisplayField>Progress_Percentage__c</errorDisplayField>
    <errorMessage>Completed goals must have 100% progress</errorMessage>
</ValidationRule>
