<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Completed_Goal_Requires_Outcome</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(Status__c, &quot;Completed&quot;),
  ISBLANK(Outcome_Comments__c)
)</errorConditionFormula>
    <errorDisplayField>Outcome_Comments__c</errorDisplayField>
    <errorMessage>Completed goals must have outcome comments</errorMessage>
</ValidationRule>
