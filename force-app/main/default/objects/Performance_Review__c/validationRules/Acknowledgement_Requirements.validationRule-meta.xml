<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Acknowledgement_Requirements</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  Is_Acknowledged__c,
  OR(
    ISBLANK(Acknowledged_Date__c),
    NOT(ISPICKVAL(Status__c, &quot;Acknowledged&quot;))
  )
)</errorConditionFormula>
    <errorMessage>Acknowledged Date is required and Status must be Acknowledged</errorMessage>
</ValidationRule>
