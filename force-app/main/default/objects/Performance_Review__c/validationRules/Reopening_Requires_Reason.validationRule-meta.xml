<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Reopening_Requires_Reason</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  Is_Reopened__c,
  ISBLANK(Reopen_Reason__c)
)</errorConditionFormula>
    <errorMessage>Reopen Reason is required when the review is reopened</errorMessage>
</ValidationRule>
