<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validate_Final_Rating</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(Status__c, &quot;Finalized&quot;),
  ABS(Final_Rating__c - Weighted_Goal_Score__c) &gt; 0.01,
  ISBLANK(Manager_Comments__c)
)</errorConditionFormula>
    <errorMessage>Explain why the Final Rating differs from the calculated Weighted Goal Score</errorMessage>
</ValidationRule>
