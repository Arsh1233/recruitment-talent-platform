<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Version_Must_Be_Positive</fullName>
    <active>true</active>
    <errorConditionFormula>Version_Number__c &lt;= 0</errorConditionFormula>
    <errorMessage>Version Number must be greater than 0</errorMessage>
</ValidationRule>
