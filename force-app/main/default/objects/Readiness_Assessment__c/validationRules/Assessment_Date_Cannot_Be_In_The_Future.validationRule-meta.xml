<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Assessment_Date_Cannot_Be_In_The_Future</fullName>
    <active>true</active>
    <errorConditionFormula>Assessment_Date__c &gt; TODAY()</errorConditionFormula>
    <errorDisplayField>Assessment_Date__c</errorDisplayField>
    <errorMessage>Assessment Date cannot be in the future</errorMessage>
</ValidationRule>
