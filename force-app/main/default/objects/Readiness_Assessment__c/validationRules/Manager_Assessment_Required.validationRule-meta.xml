<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Manager_Assessment_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
NOT(Is_Superseded__c),
ISBLANK(Manager_Assessment__c)
)</errorConditionFormula>
    <errorMessage>Manager Assessment is required when the position is not superseded.</errorMessage>
</ValidationRule>
