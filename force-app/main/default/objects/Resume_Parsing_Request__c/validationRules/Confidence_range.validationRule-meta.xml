<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Confidence_range</fullName>
    <active>true</active>
    <errorConditionFormula>AND(    NOT(ISBLANK(Confidence_Summary__c)),    OR(        Confidence_Summary__c &lt; 0,        Confidence_Summary__c &gt; 100    ) )</errorConditionFormula>
    <errorMessage>Confidence range</errorMessage>
</ValidationRule>
