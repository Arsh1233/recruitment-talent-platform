<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Verification_timestamp_required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(    Is_Candidate_Verified__c,    ISBLANK(Verification_At__c) )</errorConditionFormula>
    <errorMessage>Verification timestamp required</errorMessage>
</ValidationRule>
