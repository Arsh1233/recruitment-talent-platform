<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Explanation_Required_After_Proposal</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
NOT(ISPICKVAL(Status__c, &quot;Proposed&quot;)),
ISBLANK(Recommendation_Explanation__c)
)</errorConditionFormula>
    <errorMessage>Recommendation Explanation is required when Status is not Proposed.</errorMessage>
</ValidationRule>
