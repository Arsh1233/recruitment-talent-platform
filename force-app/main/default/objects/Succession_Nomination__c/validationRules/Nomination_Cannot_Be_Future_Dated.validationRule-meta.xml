<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Nomination_Cannot_Be_Future_Dated</fullName>
    <active>true</active>
    <errorConditionFormula>Nomination_Date__c &gt; TODAY()</errorConditionFormula>
    <errorMessage>Nomination Date cannot be in the future</errorMessage>
</ValidationRule>
