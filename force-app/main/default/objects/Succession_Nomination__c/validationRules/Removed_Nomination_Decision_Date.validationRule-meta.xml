<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Removed_Nomination_Decision_Date</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL(Status__c, &quot;Removed&quot;),
ISBLANK(Decision_Date__c)
)</errorConditionFormula>
    <errorMessage>Decision Date is required when Status is Removed</errorMessage>
</ValidationRule>
